{
  "name": "icethick",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:api": "cd ../api && func start",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "build": "next build && node --env-file-if-exists=.env.local scripts/prepare-hosting.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "test": "node --test scripts/hosting.test.mjs",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@types/mapbox-gl": "^3.4.1",
    "mapbox-gl": "^3.18.1",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
