# Local frontend configuration. NEXT_PUBLIC_* values are embedded in the
# static site at build time. Never put private credentials in this file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:7071/api
# This is the Functions/public API BASE URL, including /api.
# Production may use /api if SWA Standard has the Function App explicitly
# linked as its backend (or another same-origin proxy is configured).
# Merely hosting the frontend on SWA does not link the separately deployed API.

# Public browser token. Restrict its allowed URLs to local and production sites.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiYXN0cGhlbnMxMDA2IiwiYSI6ImNta3VxcDMyNzFqd3UzZG9kemVucmdudmMifQ.GtH22K3wSgDiILPgQN0SdQ

# Optional analytics project IDs. Analytics load only after visitor consent.
# Leave blank locally to avoid recording development traffic.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Q8N76ZWWP4
NEXT_PUBLIC_CLARITY_PROJECT_ID=z6lr6wnoka

# Production build: NEXT_PUBLIC_SITE_URL=https://icerelay.net
# NEXT_PUBLIC_API_URL=https://<public-api-host>/api

# Add these same names as GitHub Actions repository secrets, then rebuild.
# SQL and AzureWebJobsStorage backend connection strings

# belong in api/local.settings.json / Function App settings, NOT in SWA frontend
# variables. This app has no browser-facing Storage account base URL.

# Required BACKEND values are listed in api/local.settings.example.json:
# AzureWebJobsStorage=UseDevelopmentStorage=true (local Azurite)

# Production AzureWebJobsStorage:

# AzureWebJobsStorage=DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<private-key>;EndpointSuffix=core.windows.net

# SqlConnectionString=Server=tcp:
# thicknessapp-server.database.windows.net,1433;Initial Catalog=icethickness-db;Persist Security Info=False;User ID=CloudSAa766b519;Password={your_password};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# RATE_LIMIT_HASH_SECRET=<unique-random-secret>
# Application Insights is not used; no telemetry connection string is needed.
